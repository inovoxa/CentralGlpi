    {
      "parameters": {
        "jsCode": "\nconst statusMap={1:'🆕 Novo',2:'🔧 Em andamento',3:'🔧 Em andamento (planejado)',4:'⏳ Pendente',5:'✅ Resolvido',6:'🔒 Fechado'};\nfunction mapAprov(v,comment){\n  v=Number(v);\n  if(v===2) return '⏳ *AGUARDANDO APROVAÇÃO do superior*';\n  if(v===3) return '✅ *APROVADO pelo superior*';\n  if(v===4) return '❌ *RECUSADO pelo superior*'+(comment?(' — motivo: '+comment):'');\n  return '➖ Não requer aprovação';\n}\nfunction tFmt(t,aprov){\n  const st = typeof t.status==='object'&&t.status!==null?(t.status.id||t.status):Number(t.status);\n  return {\n    id:t.id,\n    titulo:t.name,\n    aprovacao: aprov,\n    status: statusMap[st]||('Status '+st),\n    data_abertura:t.date,\n    ultima_atualizacao:t.date_mod,\n    categoria: typeof t.category==='object'&&t.category!==null?t.category.name:(t.category||'N/A'),\n    url:'https://suporte.araraquara.sp.gov.br/front/ticket.form.php?id='+t.id\n  };\n}\nlet isById=false, ticket=null, timeline=[];\ntry { ticket=$('Buscar por ID').first().json; timeline=$('Buscar Aprovacao').all().map(i=>i.json); if(ticket&&ticket.id) isById=true; } catch(e){ isById=false; }\nif(isById){\n  if(typeof ticket.status==='string' && ticket.status.startsWith('ERROR')) return [{json:{erro:true, mensagem:'Chamado não encontrado. Verifique o número informado.'}}];\n  let vstatus=null, vcomment='';\n  let best=-1;\n  for(const e of (Array.isArray(timeline)?timeline:[])){\n    if(e && (e.type==='TicketValidation'||e.type==='Validation') && e.item){\n      const idn=Number(e.item.id||0);\n      if(idn>=best){ best=idn; vstatus=Number(e.item.status); vcomment=(e.item.comment_validation||'').replace(/<[^>]*>/g,'').trim(); }\n    }\n  }\n  if(vstatus===null){\n    const gv=ticket.global_validation;\n    vstatus = (gv && typeof gv==='object') ? Number(gv.id) : Number(gv);\n    if(!vstatus || isNaN(vstatus)) vstatus=1;\n  }\n  return [{json: tFmt(ticket, mapAprov(vstatus,vcomment))}];\n}\nconst raw=$input.first().json;\nif(typeof raw.status==='string' && raw.status.startsWith('ERROR')) return [{json:{erro:true, mensagem:'Chamado não encontrado.'}}];\nconst items=Array.isArray(raw)?raw:$input.all().map(i=>i.json);\nconst result=items.filter(t=>t&&t.id).map(t=>{ const gv=t.global_validation; let v=(gv&&typeof gv==='object')?Number(gv.id):Number(gv); if(!v||isNaN(v)) v=1; return {json: tFmt(t, mapAprov(v,''))}; });\nif(result.length===0) return [{json:{erro:true, mensagem:'Nenhum chamado encontrado.'}}];\nreturn result;"
      },
