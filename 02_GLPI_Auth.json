    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT client_id, client_secret, glpi_username, glpi_password, base_url, app_token_v2\n       FROM glpi_n8n.glpi_token_cache WHERE id=1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        420
      ],
      "id": "node-0005",
