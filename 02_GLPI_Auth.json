      "credentials": {
        "postgres": {
          "id": "Prefeitura_PG",
          "name": "Prefeitura_PG"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://suporte.araraquara.sp.gov.br/api.php/token",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            },
            {
              "name": "App-Token",
              "value": "={{ ($json.app_token_v2 || '').replace(/\\s+/g, '') }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "password"
            },
            {
              "name": "client_id",
              "value": "={{ ($json.client_id || '').replace(/\\s+/g, '') }}"
            },
            {
              "name": "client_secret",
              "value": "={{ ($json.client_secret || '').replace(/\\s+/g, '') }}"
            },
            {
              "name": "username",
              "value": "={{ ($json.glpi_username || '').replace(/[\\r\\n]+/g, '') }}"
            },
            {
              "name": "password",
              "value": "={{ ($json.glpi_password || '').replace(/[\\r\\n]+/g, '') }}"
            },
            {
              "name": "scope",
              "value": "api"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ],
