      "typeVersion": 2.2,
      "position": [
        1340,
        420
      ],
      "id": "node-0007",
      "name": "Token OK?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE glpi_n8n.glpi_token_cache\n       SET access_token='{{ $json.access_token }}',\n           obtained_at=NOW(),\n           expires_at=NOW() + INTERVAL '55 minutes'\n       WHERE id=1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
