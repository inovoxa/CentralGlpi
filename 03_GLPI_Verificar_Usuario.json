        "query": "INSERT INTO glpi_n8n.glpi_usuarios_cache\n         (chave_busca,tipo_chave,glpi_user_id,glpi_login,glpi_nome,glpi_email,glpi_is_active,encontrado)\n       VALUES(\n         '{{ $('Trigger').item.json.email||$('Trigger').item.json.login }}','email',\n         {{ $json.user_id }},'{{ $json.login }}','{{ $json.nome }}',\n         '{{ $json.email }}',{{ $json.is_active }},true\n       )\n       ON CONFLICT(chave_busca) DO UPDATE SET\n         glpi_user_id=EXCLUDED.glpi_user_id, glpi_login=EXCLUDED.glpi_login,\n         glpi_is_active=EXCLUDED.glpi_is_active,\n         cached_at=NOW(), expires_at=NOW()+INTERVAL '24 hours';",
