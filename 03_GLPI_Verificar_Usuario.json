        "jsCode": "\nconst raw = $input.first().json;\nconst data = Array.isArray(raw) ? raw[0] : raw;\nreturn [{json:{\n  user_id: data.id,\n  login:   data.name,\n  nome:    (data.firstname||'') + ' ' + (data.realname||''),\n  email:   data.emails?.[0]?.email || data.email || '',\n  is_active: data.is_active === 1,\n  encontrado: true\n}}];"
