    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (glpi_ticket_id)\n  conversa_id, glpi_ticket_id,\n  COALESCE(last_notified_followup_id, 0) AS last_fup_id,\n  COALESCE(last_notified_validation_id, 0) AS last_val_id\nFROM glpi_n8n.chamados_log\nWHERE glpi_ticket_id IS NOT NULL\n  AND conversa_id IS NOT NULL\n  AND conversa_id != ''\n  AND created_at > NOW() - INTERVAL '1 day' * {{ $('Config').item.json.dias_verificar }}\nORDER BY glpi_ticket_id, created_at DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        6256,
        1216
      ],
      "id": "6a16adf4-e281-42df-b016-fb9dd1eb5448",
      "name": "Buscar Chamados",
      "credentials": {
        "postgres": {
          "id": "n4vFFnEj3QjMommF",
          "name": "GLPI PMA"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const token = $('Chamar Auth').item.json.access_token;\nconst glpiApiUserId = $('Config').item.json.glpi_api_user_id;\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const ticketId = item.json.glpi_ticket_id;\n  const conversaId = item.json.conversa_id;\n  const lastFupId = item.json.last_fup_id || 0;\n  const lastValId = item.json.last_val_id || 0;\n\n  try {\n    const timeline = await this.helpers.httpRequest({\n      method: 'GET',\n      url: 'https://suporte.araraquara.sp.gov.br/api.php/v2/Assistance/Ticket/' + ticketId + '/Timeline',\n      headers: { 'Authorization': 'Bearer ' + token }\n    });\n\n    const entries = Array.isArray(timeline) ? timeline : [];\n\n    for (const entry of entries) {\n      // === Followup / Solução (existente) ===\n      if ((entry.type === 'Followup' || entry.type === 'Solution') &&\n          entry.item && entry.item.id > lastFupId) {\n        if (entry.item.user && entry.item.user.id === glpiApiUserId) continue;\n        const content = (entry.item.content || '').replace(/<[^>]*>/g, '').trim();\n        if (!content) continue;\n        const userName = entry.item.user ? entry.item.user.name : 'Técnico';\n        const date = entry.item.date || '';\n        const tipo = entry.type === 'Solution' ? 'Solução' : 'Resposta';\n        results.push({\n          json: {\n            conversa_id: conversaId,\n            ticket_id: ticketId,\n            followup_id: entry.item.id,\n            validation_id: 0,\n            mensagem: '\\u{1F4E9} *' + tipo + ' no Chamado #' + ticketId + '*\\n' +\n                      '*De:* ' + userName + '\\n' +\n                      '*Em:* ' + date + '\\n\\n' +\n                      content\n          }\n        });\n      }\n\n      // === Aprovação / Recusa de Validação (NOVO) ===\n      if ((entry.type === 'TicketValidation' || entry.type === 'Validation') &&\n          entry.item && entry.item.id > lastValId) {\n        const status = Number(entry.item.status);\n        // Status 3 = Aprovado no GLPI\n        if (status === 3) {\n          results.push({\n            json: {\n              conversa_id: conversaId,\n              ticket_id: ticketId,\n              followup_id: 0,\n              validation_id: entry.item.id,\n              mensagem: '\\u2705 *Chamado #' + ticketId + ' — Aprovado*\\n\\n' +\n                        'Seu chamado foi aprovado pelo superior imediato. ' +\n                        'Nosso assistente dará continuidade à solicitação.'\n            }\n          });\n        }\n        // Status 4 = Recusado no GLPI\n        if (status === 4) {\n          const motivo = (entry.item.comment_validation || '').replace(/<[^>]*>/g, '').trim();\n          results.push({\n            json: {\n              conversa_id: conversaId,\n              ticket_id: ticketId,\n              followup_id: 0,\n              validation_id: entry.item.id,\n              mensagem: '\\u274C *Chamado #' + ticketId + ' — Recusado*\\n\\n' +\n                        'Seu chamado foi recusado pelo superior imediato.' +\n                        (motivo ? '\\n*Motivo:* ' + motivo : '')\n            }\n          });\n        }\n      }\n    }\n  } catch (e) { /* ignora erro */ }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6464,
        1216
      ],
