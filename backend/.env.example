# ============================================================
# Central de Operações GLPI — backend (Fastify)
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# No Coolify, defina estas como Environment Variables do serviço.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
# Pasta do front estático servido pelo backend (relativa à raiz do backend).
STATIC_DIR=../sistema web

# --- Segredos da aplicação (gere valores fortes e únicos) ---
# Assinatura do cookie/JWT de sessão. Ex.: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
# Chave para cifrar o segredo TOTP no banco (AES-256-GCM). 32 bytes em hex (64 chars).
# Ex.: openssl rand -hex 32
TOTP_ENC_KEY=
# Marca exibida no app autenticador
TOTP_ISSUER=Central GLPI

# Senha inicial atribuída aos usuários no `npm run seed` (todos entram com ela
# e trocam no primeiro acesso). Se vazio, o seed gera uma aleatória e imprime.
SEED_DEFAULT_PASSWORD=

# --- Política de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# --- PostgreSQL (schema glpi_n8n / public — mesmo banco dos workflows n8n) ---
PG_HOST=
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=Prefeitura_Municipal_de_Araraquara
PG_SCHEMA=glpi_n8n
# Alternativa: uma única URL (tem prioridade se preenchida)
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- MySQL do GLPI (LEITURA — use um usuário somente-SELECT) ---
GLPI_DB_HOST=
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_ro
GLPI_DB_PASSWORD=
GLPI_DB_DATABASE=glpi
# API REST v1 do GLPI (usada para gravar status ao mover cards no Kanban).
# Tokens (app_token/user_token) são lidos de glpi_n8n.glpi_token_cache.
GLPI_API_V1_URL=https://suporte.araraquara.sp.gov.br/api.php/v1

# --- Chatwoot (Fase 4) — pode reaproveitar o que está em glpi_token_cache ---
# Se vazio, o backend tenta ler de glpi_n8n.glpi_token_cache (chatwoot_url/chatwoot_token).
CHATWOOT_URL=
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=

# --- SSH para o Domain Controller (Fase 6 — coletor de auditoria AD) ---
AD_SSH_HOST=
AD_SSH_PORT=22
AD_SSH_USER=
# Use chave privada (recomendado) OU senha
AD_SSH_PRIVATE_KEY_PATH=
AD_SSH_PASSWORD=
# Intervalo do coletor (cron). Default a cada 5 min.
AD_COLLECTOR_CRON=*/5 * * * *
